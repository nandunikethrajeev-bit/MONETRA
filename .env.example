# MONETRA — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/monetra_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=your_secure_mysql_password

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_in_production
JWT_VALIDITY_SECONDS=86400

# Server Configuration
SERVER_PORT=8080

# API Client Mode for Desktop App (REMOTE or DIRECT)
# Set to 'REMOTE' to connect to running monetra-api REST service, or 'DIRECT' to run standalone with local database
MONETRA_DESKTOP_MODE=DIRECT
MONETRA_API_BASE_URL=http://localhost:8080/api/v1

